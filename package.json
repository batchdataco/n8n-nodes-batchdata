{
  "name": "n8n-nodes-batchdata",
  "version": "0.2.0",
  "description": "n8n community nodes for the BatchData API: property search and lookup, skip trace, reverse skip trace, permits, investors, address and phone checks, search sessions, property monitors, polling and instant triggers",
  "license": "MIT",
  "homepage": "https://github.com/batchdataco/n8n-nodes-batchdata#readme",
  "keywords": [
    "n8n-community-node-package",
    "batchdata",
    "real estate",
    "property data",
    "skip trace"
  ],
  "author": {
    "name": "BatchData",
    "email": "support@batchservice.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batchdataco/n8n-nodes-batchdata.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/BatchDataApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/BatchData/BatchData.node.js",
      "dist/nodes/BatchDataTrigger/BatchDataTrigger.node.js",
      "dist/nodes/BatchDataMonitorTrigger/BatchDataMonitorTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
